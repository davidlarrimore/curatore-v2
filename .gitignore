# ============================================================================
# Curatore v2 - Git Ignore
# ============================================================================

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
.eggs/
.env
config.yml
.venv/
**/.venv/

# Node (frontend extracted to curatore-frontend repo)
# These entries kept for any remaining JS tooling
npm-debug.log*

# OS
.DS_Store
Thumbs.db

/logs
logs/


# Docker
*.log

# Database files (keep structure, ignore contents)
/backend/data/*.db
/backend/data/*.db-shm
/backend/data/*.db-wal

# Keep directory marker
!/backend/data/.gitkeep


.pytest_cache/

# Coverage reports
.coverage
.coverage.*
htmlcov/
coverage/
*_coverage_html/

# Temporary documentation and status files
STATUS*.txt
STATUS*.md
CHECKPOINT*.md
ROADMAP*.md
SESSION*.md
PHASE*.md
IMPLEMENTATION*.md
CHANGES*.md
**/plan-*.md
plan-header.md
